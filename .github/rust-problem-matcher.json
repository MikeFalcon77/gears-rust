{
  "problemMatcher": [
    {
      "owner": "rustc-error",
      "pattern": [
        {
          "regexp": "^(?:\u001b\\[[0-9;]*m)*(error)(?:\\[([^\\]]+)\\])?(?:\u001b\\[[0-9;]*m)*: (.*?)(?:\u001b\\[[0-9;]*m)*$",
          "severity": 1,
          "code": 2,
          "message": 3
        },
        {
          "regexp": "^\\s*(?:\u001b\\[[0-9;]*m)*-->\\s*(?:\u001b\\[[0-9;]*m)*([^\\s:]+):(\\d+):(\\d+)",
          "file": 1,
          "line": 2,
          "column": 3
        }
      ]
    }
  ]
}
