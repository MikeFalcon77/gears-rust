# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox description for the bss-rating gear, which has no crate yet.
#
# `implementation = "design"`: listed in the catalogue with its documents, and
# not usable in a product (GBX0321). When the crate exists, describe it beside
# the crate instead -- `package = cargo(...)` and a `maturity`, no `id`
# (projected from #[toolkit::gear] then) -- and delete this file.

gear(
    gdl_version = "1.0",
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/bss/rating"),
    implementation = "design",
    id = "bss-rating",
    name = "Rating",
    description = "Deterministic usage rating engine converting metered consumption into auditable charges.",
    category = "bss",
    # From docs/GEARS.md.
    scenarios = [
        scenario("deterministic charge evaluation with byte-for-byte reproducible outputs", priority = "p1"),
        scenario("pricing model coverage: flat, per_unit, tiered, volume, package, hybrid, committed-usage", priority = "p1"),
        scenario("multi-tenant hierarchy evaluation (platform owner, channel partner, end customer)", priority = "p1"),
        scenario("multi-currency correctness with separated price/invoice/settlement currencies", priority = "p2"),
        scenario("rule-version audit trail with UTC effective dating", priority = "p2"),
        scenario("usage ingestion, windowed aggregation, dedup, and evaluation-unit synthesis", priority = "p2"),
        scenario("retroactivity, corrections, and period-level obligations", priority = "p3"),
        scenario("commitments, reservations, and coupons overlay", priority = "p4"),
    ],
)
