# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox description for the bss-contracts gear, which has no crate yet.
#
# `implementation = "design"`: listed in the catalogue with its documents, and
# not usable in a product (GBX0321). When the crate exists, describe it beside
# the crate instead -- `package = cargo(...)` and a `maturity`, no `id`
# (projected from #[toolkit::gear] then) -- and delete this file.

gear(
    gdl_version = "1.0",
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/bss/contracts"),
    implementation = "design",
    id = "bss-contracts",
    name = "Contracts & Agreements",
    description = "System of Record for signed commercial terms, negotiated prices, and commitments.",
    category = "bss",
    # From docs/GEARS.md.
    scenarios = [
        scenario("contract document lifecycle (draft, active, expired, terminated)", priority = "p1"),
        scenario("terms consumed by Subscriptions (renewal, grace, limits)", priority = "p1"),
        scenario("negotiated price overrides as highest-precedence rating layer", priority = "p2"),
        scenario("commitments, prepaid pools, and ramps", priority = "p2"),
        scenario("booking, acceptance, and eligibility rules", priority = "p3"),
        scenario("event publication for downstream consumers", priority = "p3"),
    ],
)
