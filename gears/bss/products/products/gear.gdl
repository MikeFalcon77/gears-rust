# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for the bss-products gear.
#
# Projected from #[toolkit::gear]: id, runtime_caps (db, rest, stateful),
# colocated_deps (authz-resolver, types-registry, usage-collector), lifecycle;
# the ProductCatalogClientV1 contract from #[toolkit::provides].

gear(
    gdl_version = "1.0",
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/bss/products/products"),
    maturity = "preview",
    implementation = "in-progress",
    name = "Product & SKU Management",
    description = "Multi-tenant catalog registry for products, SKUs, taxonomy, and versioned snapshots.",
    category = "bss",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-bss-products",
        lib = "bss_products",
        path = ".",
    ),
    sdk = cargo(
        crate_name = "cf-gears-bss-products-sdk",
        lib = "bss_products_sdk",
        path = "../products-sdk",
    ),

    config_schema = config(),
    # From docs/GEARS.md.
    scenarios = [
        scenario("create and manage products and SKUs with tenant isolation", priority = "p1"),
        scenario("category and taxonomy management with hierarchical classification", priority = "p1"),
        scenario("attribute schemas, localization, and multi-currency display names", priority = "p2"),
        scenario("immutable catalog versioning and deterministic snapshots", priority = "p2"),
        scenario("approval-gated publishing with two-person rule and CloudEvents audit trail", priority = "p2"),
        scenario("bulk operations, cloning, and import/export", priority = "p3"),
        scenario("partner/brand/region-scoped offerings and marketplace integration", priority = "p4"),
    ],
)
