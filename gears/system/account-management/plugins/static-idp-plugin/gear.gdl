# Gearbox product metadata for the Static IdP Plugin.
#
# Fills account-management's identity-provider extension point
# (`IdpPluginClient`) with a permissive echo, for development and end-to-end
# stacks. The point, vendor and priority are read from source; only the sdk
# locator is declared.
#
# No gear.toml exists for it: name and description are the crate's own, and the
# category is the host family's.

gear(
    name = "Static IdP Plugin",
    description = "Permissive echo identity provider for Account Management development and end-to-end stacks.",
    category = "oss",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-static-idp-plugin",
        lib = "static_idp_plugin",
        path = ".",
    ),

    sdk = cargo(
        crate_name = "cf-gears-account-management-sdk",
        lib = "account_management_sdk",
        path = "../../account-management-sdk",
    ),

    config_schema = config(exposes = ["vendor", "priority"]),
)
