# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for the types-registry gear.
#
# Projected from #[toolkit::gear]: id, runtime_caps (system, db, rest,
# stateful), and the lifecycle (entry `serve`, stop timeout 30s, awaits
# readiness).

gear(
    gdl_version = "1.2",
    ui = ui_module(package = path("../ui"), requires = ["types-registry"]),
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/system/types-registry/types-registry"),
    maturity = "preview",
    implementation = "in-progress",
    name = "Types Registry",
    # Pulled in by roughly 22 gears via deps, so it is linked into most
    # applications.
    description = "Central GTS schema registry for type contracts, validation, and cross-gear discovery.",
    category = "core-functionality",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-types-registry",
        lib = "types_registry",
        path = ".",
    ),

    # Deliberately empty rather than absent: the crate's only feature is
    # `integration`, which wants a Docker daemon. "Nothing here for you" is the
    # true answer, and it is not the same as saying nothing.
    cargo_features = [],
    # From docs/GEARS.md.
    scenarios = [
        scenario("get schema by ID (for LLM Gateway tool resolution)", priority = "p1", done = True),
        scenario("batch get schemas", priority = "p1", done = True),
        scenario("validate, register and resolve types and instances by versioned identifiers", priority = "p2", done = True),
        scenario("distribute GTS instances and schemas updates across gears safely via events generation", priority = "p2"),
        scenario("schemas and instances import/export in different formats (YAML, RAML)", priority = "p3"),
    ],
)
