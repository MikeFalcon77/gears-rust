# Gearbox product metadata for the Static License Plugin.
#
# Fills license-resolver's extension point. Which point that is, and this
# plugin's vendor and priority, are all read from source; only the sdk locator
# is declared. There is no gear.toml beside it: the name and description are
# the crate's own, the category is the host's.

gear(
    name = "Static License Plugin",
    description = "License grants from static configuration rules, for development and testing.",
    category = "core-platform-integration",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-static-license-plugin",
        lib = "static_license_plugin",
        path = ".",
    ),

    sdk = cargo(
        crate_name = "cf-gears-license-resolver-sdk",
        lib = "license_resolver_sdk",
        path = "../../license-resolver-sdk",
    ),

    # `grants` is a list of rules; no control renders it, so it stays in the
    # configuration file.
    config_schema = config(exposes = ["vendor", "priority"]),
)
