# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for OAGW, the Outbound API Interface.
#
# Projected from #[toolkit::gear]: id, runtime_caps (system, rest),
# colocated_deps (types-registry, authz-resolver, credstore, tenant-resolver).

gear(
    gdl_version = "1.0",
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/system/oagw/oagw"),
    maturity = "preview",
    implementation = "in-progress",
    name = "Outbound API Interface",
    description = "Abstraction layer for outbound API calls with credential injection and observability.",
    category = "core-platform-integration",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-oagw",
        lib = "oagw",
        path = ".",
    ),

    sdk = cargo(
        crate_name = "cf-gears-oagw-sdk",
        lib = "oagw_sdk",
        path = "../oagw-sdk",
    ),

    # Timeouts, limits and the two policy switches. `ssrf_policy` and `metrics`
    # are nested sections and stay in the configuration file.
    config_schema = config(exposes = [
        "proxy_timeout_secs",
        "max_body_size_bytes",
        "allow_http_upstream",
        "token_cache_ttl_secs",
        "token_cache_capacity",
        "websocket_idle_timeout_secs",
        "websocket_close_timeout_secs",
        "streaming_idle_timeout_secs",
        "protocol_cache_ttl_secs",
        "management_api_enabled",
    ]),

    # `fips` restricts TLS to FIPS-approved suites, a real deployment choice.
    # `test-utils` is test scaffolding and is not offered.
    cargo_features = [feature("fips")],
    # From docs/GEARS.md.
    scenarios = [
        scenario("define outbound endpoints and execute calls with tracing", priority = "p1", done = True),
        scenario("adapter for single-user and single-tenant use-cases (desktop app)", priority = "p2"),
        scenario("outbound calls metrics collection", priority = "p2"),
        scenario("minimalistic rate limiting", priority = "p3"),
        scenario("audit with retention for outbound calls", priority = "p4"),
    ],
)
