# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox description for the quota-enforcement gear, which has no crate yet.
#
# `implementation = "design"`: listed in the catalogue with its documents, and
# not usable in a product (GBX0321). When the crate exists, describe it beside
# the crate instead -- `package = cargo(...)` and a `maturity`, no `id`
# (projected from #[toolkit::gear] then) -- and delete this file.

gear(
    gdl_version = "1.0",
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/system/quota-enforcement"),
    implementation = "design",
    id = "quota-enforcement",
    name = "Quota Enforcer",
    description = "Quota enforcement with validation, reservation, and commit/release lifecycle.",
    category = "core-functionality",
    # From docs/GEARS.md.
    scenarios = [
        scenario("check and reserve quota before execution", priority = "p1"),
        scenario("enforce tenant, user, and workload limits", priority = "p1"),
        scenario("reconcile quota usage from Usage Collector", priority = "p2"),
        scenario("support soft and hard limit policies with alerts", priority = "p3"),
    ],
)
