# Gearbox product metadata for the Tenant-Resolver AuthZ Plugin.
#
# Fills authz-resolver's extension point (`AuthZResolverPluginClient`) by
# walking the tenant hierarchy through tenant-resolver. The point, vendor and
# priority are read from source; so is the link to tenant-resolver, which the
# attribute states as `deps = [types_registry, tenant_resolver]`. Only the sdk
# locator is declared.
#
# No gear.toml exists for it: name and description are the crate's own, and the
# category is the host's.

gear(
    name = "Tenant-Resolver AuthZ Plugin",
    description = "Authorization over the tenant hierarchy, resolved through Tenant Resolver.",
    category = "core-platform-integration",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-tr-authz-plugin",
        lib = "tr_authz_plugin",
        path = ".",
    ),

    sdk = cargo(
        crate_name = "cf-gears-authz-resolver-sdk",
        lib = "authz_resolver_sdk",
        path = "../../authz-resolver-sdk",
    ),

    config_schema = config(exposes = ["vendor", "priority"]),
)
