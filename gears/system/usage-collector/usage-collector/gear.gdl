# Gearbox product metadata for the Usage Collector.
#
# Projected from #[toolkit::gear]: id, runtime_caps (rest, stateful),
# colocated_deps (types-registry, authz-resolver), and the lifecycle
# (entry `serve`, stop timeout 30s). Storage is a plugin, chosen by `vendor`.

gear(
    name = "Usage Collector",
    description = "Centralized usage metering with pluggable storage, aggregation, and replay-safe feeds.",
    category = "core-functionality",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-usage-collector",
        lib = "usage_collector",
        path = ".",
    ),

    sdk = cargo(
        crate_name = "cf-gears-usage-collector-sdk",
        lib = "usage_collector_sdk",
        path = "../usage-collector-sdk",
    ),

    # `vendor` selects the storage plugin. `metrics` is a nested struct and
    # stays in the configuration file.
    config_schema = config(exposes = ["vendor"]),
)
