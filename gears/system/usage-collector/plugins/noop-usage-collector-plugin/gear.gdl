# Gearbox product metadata for the Noop Usage Collector Plugin.
#
# One of two storage backends filling usage-collector's extension point.
# Which point that is, and this plugin's vendor and priority, are all read
# from source; only the sdk locator is declared.

gear(
    name = "Noop Usage Collector Plugin",
    description = "No-op storage backend plugin for Usage Collector testing and development.",
    category = "core-functionality",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-noop-usage-collector-plugin",
        lib = "noop_usage_collector_plugin",
        path = ".",
    ),

    sdk = cargo(
        crate_name = "cf-gears-usage-collector-sdk",
        lib = "usage_collector_sdk",
        path = "../../usage-collector-sdk",
    ),

    config_schema = config(exposes = ["vendor", "priority"]),
)
