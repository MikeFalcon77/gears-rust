# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for the settings-service gear.
#
# Projected from #[toolkit::gear]: id, runtime_caps (db, rest, stateful),
# colocated_deps (types-registry, credstore), lifecycle; the authz-resolver
# edge from #[toolkit::consumes].

SETTINGS_READ_SDK = cargo(crate_name = "cf-gears-settings-service-sdk", lib = "cf_gears_settings_service_sdk", path = "../settings-service-sdk", features = ["rest-client"])

gear(
    ui = ui_module(package = path("../ui"), requires = ["settings-service", "event-broker"]),
    gdl_version = "1.2",
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/settings-service/settings-service"),
    maturity = "preview",
    implementation = "in-progress",
    name = "Settings Service",
    description = "Typed configuration and feature flags with tenant-scoped inheritance and validate-then-set writes.",
    category = "serverless",
    visibility = "internal",

    # Both crates name their library target explicitly, after the package
    # name with underscores -- not `settings_service`.
    package = cargo(
        crate_name = "cf-gears-settings-service",
        lib = "cf_gears_settings_service",
        path = ".",
    ),
    sdk = cargo(
        crate_name = "cf-gears-settings-service-sdk",
        lib = "cf_gears_settings_service_sdk",
        path = "../settings-service-sdk",
    ),

    provides = [provide(contract = "SettingsReadApi", rust = "settings_service_sdk::SettingsReadApi", sdk = SETTINGS_READ_SDK, local = "Self::build_remote_reader", rest = rest(base_path = "/settings-service/v1"))],
    config_schema = config(exposes = ["community_events"]),
    # From docs/GEARS.md.
    scenarios = [
        scenario("CRUD settings per tenant and per user", priority = "p1"),
        scenario("schema validation and versioning", priority = "p1"),
        scenario("settings inheritance rules", priority = "p2"),
        scenario("feature flags and rollout controls", priority = "p3"),
        scenario("events generation per setting creation/update/deletion", priority = "p3"),
    ],
)
