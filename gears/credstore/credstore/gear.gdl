# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for the credstore gear.
#
# Projected from #[toolkit::gear]: id, runtime_caps (system, db, rest,
# stateful), colocated_deps (authz-resolver, tenant-resolver, types-registry)
# and the lifecycle clause.

gear(
    gdl_version = "1.0",
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/credstore/credstore"),
    maturity = "preview",
    implementation = "in-progress",
    name = "Credentials Store",
    description = "Secure per-tenant secret storage with pluggable backends and hierarchical sharing.",
    category = "core-platform-integration",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-credstore",
        lib = "credstore",
        path = ".",
    ),

    # A locator for the SDK the extension point below is checked against --
    # the backend plugin spec and trait this gear selects an implementation of.
    sdk = cargo(
        crate_name = "cf-gears-credstore-sdk",
        lib = "credstore_sdk",
        path = "../credstore-sdk",
    ),

    # The point plugins fill, keyed by the GTS spec their instances register
    # under and this gear selects by. Declared, and checked against the sdk: the
    # spec must be a `PluginV1` type it declares, the trait a `pub trait` in it.
    extension_points = [
        extension_point("cf.core.credstore.plugin.v1~", trait = "CredStorePluginClientV1"),
    ],

    # Deliberately empty rather than absent: `test-support` pulls an
    # OpenTelemetry SDK for the crate's own tests and is not a product choice.
    cargo_features = [],
    # From docs/GEARS.md.
    scenarios = [
        scenario("store and retrieve secrets with tenant scoping", priority = "p1"),
        scenario("adapter for single-user and single-tenant use-cases (desktop app)", priority = "p1"),
        scenario("cache credential metadata and resolve provider-specific bindings", priority = "p2"),
        scenario("audit secret access through stable adapter contracts", priority = "p3"),
        scenario("integrate with external vault backends (AWS Secrets Manager, HashiCorp Vault, etc.)", priority = "p4"),
    ],
)
